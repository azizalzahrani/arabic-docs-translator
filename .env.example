# LLM Configuration
# Set at least one API key. Without a key the tool runs in dry-run mode
# (documents are processed but text is NOT translated).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic | none (leave empty to auto-detect from available keys)
LLM_PROVIDER=

# Model Configuration
# "auto" uses the provider's default model
# (override with any model your provider account supports)
TRANSLATION_MODEL=auto
REVIEW_MODEL=auto
ADAPTER_MODEL=auto
LLM_TEMPERATURE=0.3

# Optional: override the per-provider default model names
# OPENAI_DEFAULT_MODEL=gpt-4o
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# Translation Settings
QUALITY_THRESHOLD=0.8
GLOSSARY_STRICT=true
PRESERVE_MARKDOWN=true
TRANSLATE_CODE_COMMENTS=true

# Paths
OUTPUT_DIR=./translated_docs
GLOSSARY_DIR=./glossary
LOG_DIR=./logs

# Batch Processing
MAX_WORKERS=4
BATCH_SIZE=10

# Language Settings
TARGET_LANGUAGE=ar
SOURCE_LANGUAGE=en
DIALECT=ar_SA

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false
