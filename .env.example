# LLM Configuration
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_PROVIDER=openai

# Model Configuration
TRANSLATION_MODEL=gpt-4
REVIEW_MODEL=gpt-4
ADAPTER_MODEL=gpt-4

# Translation Settings
QUALITY_THRESHOLD=0.8
GLOSSARY_STRICT=true
PRESERVE_MARKDOWN=true
TRANSLATE_CODE_COMMENTS=true

# Paths
OUTPUT_DIR=./translated_docs
GLOSSARY_DIR=./glossary
LOG_DIR=./logs

# Batch Processing
MAX_WORKERS=4
BATCH_SIZE=10

# Language Settings
TARGET_LANGUAGE=ar
SOURCE_LANGUAGE=en
DIALECT=ar_SA

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false
